{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate; fi && npm run build",
  "crons": [
    {
      "path": "/api/jobs/run",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "src/app/api/[...path]/route.ts": {
      "maxDuration": 60
    }
  }
}
