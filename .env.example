# Docker PostgreSQL (local development defaults).
POSTGRES_DB=popin_lms
POSTGRES_USER=popin
POSTGRES_PASSWORD=popin_local_password
POSTGRES_PORT=5432
# Host-run Next.js and Prisma use localhost; containers use the database service name.
# Keep this URL in sync with POSTGRES_*; URL-encode special characters in credentials.
DATABASE_URL="postgresql://popin:popin_local_password@localhost:5432/popin_lms?schema=public"

# Replace with a random secret before deployment.
AUTH_SECRET=replace-with-a-random-secret
NEXT_PUBLIC_AUTH_BYPASS=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional integrations.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
JOBS_SECRET=
PUBLIC_HOST=localhost
BACKUP_PATH=./backups
ENABLE_EXTERNAL_IDENTITY=false
OCR_URL=
MARKETING_ALLOWED_HOSTS=
ALERT_WEBHOOK_URL=
# Keep ENCRYPTION_KEY stable when rotating AUTH_SECRET.
ENCRYPTION_KEY=
